# ─────────────────────────────────────────────────────────────
# EV2 CAMPUS — variables de entorno
# Copia este archivo como `.env.local` y llena lo que aplique.
# La app FUNCIONA sin ninguna de estas variables: cae a un
# almacenamiento local en /data para el piloto.
# ─────────────────────────────────────────────────────────────

# ── Panel de administrador ───────────────────────────────────
# Clave para entrar a /admin. Cámbiala antes de salir a producción.
ADMIN_PASSWORD=metrokia2026

# ── Firebase / Firestore (destino principal de los leads) ────
# Del archivo JSON de la cuenta de servicio de Firebase.
# La clave privada va entre comillas y con los \n literales.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ── Salesforce (CRM de Metrokia) ────────────────────────────
# Elige UNA de las dos opciones. Un fallo aquí NO bloquea la captura.
#
# Opción A · REST API con Connected App (recomendada para producción).
#   Setup → App Manager → New Connected App → habilitar OAuth y
#   "Client Credentials Flow" con un usuario de integración.
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v61.0
#
# Opción B · Web-to-Lead (sin credenciales, ideal para el piloto).
#   Setup → Web-to-Lead → Create Web-to-Lead Form → copiar el valor "oid".
SF_WEB_TO_LEAD_OID=
# Mientras se prueba, Salesforce manda un correo con el diagnóstico de cada envío:
SF_WEB_TO_LEAD_DEBUG_EMAIL=
#
# Comunes a ambas:
SF_LEAD_SOURCE=EV2 Campus
# Campos personalizados (opcional). JSON clave interna → campo Salesforce.
# En REST usa el API name (EV2_Score__c); en Web-to-Lead usa el Id (00N...).
# Claves disponibles: score, tier, monthlyCommitment, studentCapacity, familyGap,
# coveragePct, termMonths, downPayment, university, program, semester, age,
# eventName, totemId, dataConsent, marketingConsent, leadId
SF_FIELD_MAP=

# ── Webhook genérico (alternativa si sistemas prefiere un middleware) ──
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# ── Control del domo (efecto de humo / luces) ────────────────
# Endpoint del controlador de show que dispara el efecto al
# completarse un registro. Típicamente un equipo en la red local.
SMOKE_WEBHOOK_URL=
SMOKE_WEBHOOK_TOKEN=

# ── Identificación de la activación ──────────────────────────
NEXT_PUBLIC_EVENT_NAME=Piloto Bogotá
NEXT_PUBLIC_TOTEM_ID=DOMO-01
